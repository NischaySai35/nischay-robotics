# Firebase web config.
#
# Copy this file to `.env` and fill in the values from:
#   Firebase console -> Project settings -> Your apps -> Web app -> SDK setup
#
# These are PUBLIC values. Vite compiles them into the JavaScript bundle, and
# that is fine — they are identifiers, not secrets. What actually protects the
# waitlist is firestore.rules. Never put a private key or service account here.
#
# Leave them blank and the site still works: the waitlist form falls back to a
# prefilled email instead of writing to Firestore.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# EmailJS — waitlist emails (free: 200/month, no card). https://www.emailjs.com
# Also PUBLIC values. Leave blank and the site simply sends no email.
#   SERVICE_ID       Email Services → your Gmail service → Service ID
#   PUBLIC_KEY       Account → General → Public Key
#   TEMPLATE_ADMIN   template that emails YOU about each signup
#   TEMPLATE_CONFIRM template that emails the SUBSCRIBER a confirmation
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TEMPLATE_ADMIN=
VITE_EMAILJS_TEMPLATE_CONFIRM=
